{
  "_README": "简历画像。填完之后，workflow.py screen 会拿它逐条判定岗位该不该投、用哪份简历。这是防误投的核心，不填就等于裸投。全部字段都是占位，请按自己的真实情况改。",

  "resume_default": "<简历A名称，平台上的名字，一字不差>",
  "resumes": [
    {
      "name": "<简历A名称>",
      "signals": ["公众号", "推文", "文案", "新媒体", "内容运营", "宣传稿", "短视频", "品牌推广"]
    },
    {
      "name": "<简历B名称>",
      "signals": ["考勤", "办公用品", "固定资产", "档案管理", "会务", "后勤保障", "社保", "公积金", "入离职"]
    }
  ],

  "hard": {
    "_note": "硬性条件：任一不达标就跳过，不给分、不通融。",
    "education_min": "本科",
    "education_ban": ["硕士", "博士", "大专", "中专", "高中", "初中", "中技"],
    "graduate_years": [2027],
    "experience_max_years": 0,
    "majors": ["<专业1>", "<专业2>"],
    "major_any_ok": ["专业不限", "不限专业", "专业不限，欢迎跨专业投递"],
    "cities": ["<城市1>", "<城市2>"],
    "salary_min": 5000
  },

  "soft": {
    "_note": "软匹配：ability 用来加分，veto 命中直接出局。",
    "ability": {
      "内容生产": ["文案", "推文", "公众号", "稿件", "撰写", "编辑", "选题"],
      "新媒体": ["新媒体", "短视频", "抖音", "小红书", "直播"],
      "活动执行": ["活动", "策划", "执行", "落地", "会务", "组织"],
      "数据与复盘": ["数据", "复盘", "转化", "指标", "分析", "报表"],
      "办公与协同": ["办公软件", "Excel", "PPT", "Word", "公文", "档案"],
      "沟通协调": ["沟通", "协调", "对接", "服务", "责任心", "抗压"]
    },
    "bonus": ["五险一金", "周末双休", "带薪年假", "提供住宿"],
    "veto": ["销售", "电话销售", "地推", "业绩考核", "酒量", "夜班", "长期出差", "外派常驻"]
  },

  "apply_rules": {
    "_note": "投递规则。require_campus 打开时，JD 里必须出现届别/应届/校招才投。",
    "require_campus": true,
    "campus_words": ["校招", "校园招聘", "应届", "应届生", "在校生", "<届别，如 2027届>"],
    "neg_regex": [
      "[1-9]\\s*年以上[\\s\\S]{0,8}经验",
      "要求[\\s\\S]{0,4}[1-9]\\s*年[\\s\\S]{0,4}经验",
      "[1-9]-[1-9]年经验"
    ],
    "min_score": 2
  }
}
